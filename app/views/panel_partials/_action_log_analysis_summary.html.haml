- summary = @analysis.summary
.analysis-stats
  .analysis-stat
    %span.label Requests
    %strong= number_with_delimiter(summary[:total])
  .analysis-stat
    %span.label Average
    %strong= analysis_duration_text(summary[:average_duration])
  .analysis-stat
    %span.label 95th percentile
    %strong= analysis_duration_text(summary[:p95_duration])
