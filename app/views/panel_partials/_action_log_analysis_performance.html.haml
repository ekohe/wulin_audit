%h3 Slow controller#action
.analysis-table-wrapper
  %table.analysis-table.performance-summary
    %thead
      %tr
        %th Controller#action
        %th.numeric Requests
        %th.numeric Average
        %th.numeric P95
        %th.numeric Maximum
    %tbody
      - @analysis.slow_by_action.each do |row|
        %tr
          %td= row[:target]
          %td.numeric= number_with_delimiter(row[:count])
          %td.numeric= "#{number_with_delimiter(row[:average_duration])} ms"
          %td.numeric= "#{number_with_delimiter(row[:p95_duration])} ms"
          %td.numeric= "#{number_with_delimiter(row[:maximum_duration])} ms"

%h3 100 slowest requests
.analysis-table-wrapper.slow-requests
  %table.analysis-table.requests
    %thead
      %tr
        %th Datetime (UTC)
        %th User
        %th Controller#action
        %th Request
        %th.numeric Status
        %th.numeric Total
        %th.numeric DB
        %th.numeric View
        %th.numeric Action
    %tbody
      - @analysis.slowest_requests.each do |row|
        %tr
          %td= row[:created_at]
          %td= row[:user]
          %td= row[:target]
          %td.request
            .request-cell
              %span.request-path{title: row[:full_path]}= [row[:http_method], row[:path]].compact.join(" ")
              - if row[:full_path].present?
                %button.copy-request{type: "button", title: "Copy full path", data: {copy: row[:full_path]}} Copy
          %td.numeric= row[:status]
          %td.numeric= "#{number_with_delimiter(row[:duration])} ms"
          %td.numeric= row[:db_duration] ? "#{number_with_delimiter(row[:db_duration])} ms" : "—"
          %td.numeric= row[:view_duration] ? "#{number_with_delimiter(row[:view_duration])} ms" : "—"
          %td.numeric= row[:action_duration] ? "#{number_with_delimiter(row[:action_duration])} ms" : "—"

:javascript
  WulinAuditAnalysis.init();
